<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mtop"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/bgapp"
        android:orientation="horizontal"
        android:weightSum="1.6">

        <ImageView
            android:id="@+id/mclose"
            android:layout_width="2dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:layout_weight="0.3"
            android:src="@drawable/death_card_rip_post_baseline_keyboard_arrow_left_24" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text=" કુટુંબ ના વ્યક્તિઓ નું નામ અને નંબર  "
            android:textColor="@color/white"
            android:textSize="18dp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/mrl_saveImagesss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/mtop">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="15dp"
                    android:text="ફોર્મ 3"
                    android:textColor="@color/bgapp"
                    android:textSize="19dp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="નોંધ   : "
                            android:textColor="#d82f23"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="નામ અને નંબર ૧ ૨ ૩ ૪ ૫  સુધી ના નાખી શકાશે.ઓછામાં ઓછા ૧ વધારેમાં વધારે  ૫ નંબર નાખી શકાશે"
                            android:textColor="#168e1b"
                            android:textSize="16dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/name1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૧...................નામ..................."
                            android:maxLength="150"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />

                        <EditText
                            android:id="@+id/number1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૧...................નંબર..................."
                            android:maxLength="10"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/name2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૨...................નામ..................."
                            android:maxLength="100"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />

                        <EditText
                            android:id="@+id/number2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૨...................નંબર..................."
                            android:maxLength="10"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/name3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૩...................નામ..................."
                            android:maxLength="100"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />

                        <EditText
                            android:id="@+id/number3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="3...................નંબર..................."
                            android:maxLength="10"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/name4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૪...................નામ..................."
                            android:maxLength="100"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />

                        <EditText
                            android:id="@+id/number4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૪...................નંબર..................."
                            android:maxLength="10"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/name5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૫...................નામ..................."
                            android:maxLength="100"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />

                        <EditText
                            android:id="@+id/number5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/death_card_rip_post_ra_shpe"
                            android:gravity="center"
                            android:hint="૫...................નંબર..................."
                            android:maxLength="10"
                            android:minHeight="45dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/dull"
                            android:textSize="16dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/mset_btn"
                        android:layout_width="120dp"
                        android:layout_height="46dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/ok_bg"
                        android:gravity="center"
                        android:text="ઓકે"
                        android:textColor="@color/white"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</RelativeLayout>
