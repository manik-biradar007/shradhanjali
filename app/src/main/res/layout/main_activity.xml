<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/diya_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorbg"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtdiya"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/bgapp"
                android:gravity="center"
                android:text="Diya"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridView
                android:id="@+id/maradivanu_gridview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/txtdiya"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbars="vertical"
                android:verticalSpacing="10dp" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/Ring_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorbg"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtring"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/bgapp"
                android:gravity="center"
                android:text="Ring"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridView
                android:id="@+id/Ring_gridview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/txtring"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbars="vertical"
                android:verticalSpacing="10dp" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/jjbgRing_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorbg"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/nametxt"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/bgapp"
                android:gravity="center"
                android:text="Color"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridView
                android:id="@+id/jjbgRing_gridview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/nametxt"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbars="horizontal"
                android:verticalSpacing="10dp" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bgRing_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorbg"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtframe"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/bgapp"
                android:gravity="center"
                android:text="Frame"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridView
                android:id="@+id/bgRing_gridview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/txtframe"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbars="vertical"
                android:verticalSpacing="10dp" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/dgbgRing_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorbg"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtdesign"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/bgapp"
                android:gravity="center"
                android:text="Design"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridView
                android:id="@+id/design_gridview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/txtdesign"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:scrollbars="vertical"
                android:verticalSpacing="10dp" />
        </RelativeLayout>
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/fram_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
