                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginHorizontal="4sp"
                            android:layout_marginLeft="4sp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="4sp"
                            android:layout_marginBottom="5dp"
                            android:backgroundTint="#3bffffff"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nameofdeath"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:maxLength="100"
                                android:text="स्वर्गीय नाम"
                                android:textColor="@color/hinttextcolor"
                                android:textSize="17dp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginRight="8dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            android:weightSum="3">

                            <LinearLayout
                                android:id="@+id/ltal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="1.1"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="3dp"
                                    android:gravity="center"
                                    android:text="@string/tal1"
                                    android:textColor="@color/black"
                                    android:textSize="16dp"
                                    android:textStyle="normal" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <EditText
                                        android:id="@+id/mtal"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:hint="लिखो"
                                        android:inputType="textNoSuggestions"
                                        android:maxLength="100"
                                        android:padding="2dp"
                                        android:textColor="@color/black"
                                        android:textColorHint="#959595"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="2dp"
                                        android:background="@drawable/death_card_rip_post_dotted_line"
                                        android:backgroundTint="#3e150d0d" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/ttff1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/detail_form1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="3dp"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_67sdp"
                                    android:layout_marginHorizontal="5dp"
                                    android:layout_marginLeft="5dp"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginRight="5dp"
                                    android:background="@drawable/death_card_rip_post_hindi1" />
                            </LinearLayout>

                            <LinearLayout
