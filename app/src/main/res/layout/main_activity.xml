                            android:orientation="vertical"
                            android:paddingHorizontal="2dp"
                            android:paddingVertical="2dp"
                            android:paddingLeft="2dp"
                            android:paddingTop="2dp"
                            android:paddingRight="2dp"
                            android:paddingBottom="2dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="|| शोकसभा ||"
                                android:textColor="@color/black"
                                android:textSize="17dp"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:id="@+id/ttff2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:id="@+id/detail_form2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginBottom="5sp"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/_47sdp"
                                        android:layout_marginHorizontal="5dp"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginTop="4dp"
                                        android:layout_marginRight="5dp"
                                        android:background="@drawable/death_card_rip_post_hindi2" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="10dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginBottom="4sp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/click_besnu"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:textColor="@color/black"
                                        android:textSize="15dp" />

                                    <TextView
                                        android:id="@+id/detaillset"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:textColor="@color/black"
                                        android:textSize="15dp" />
                                </LinearLayout>
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ttff3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4sp"
                            android:layout_marginLeft="4sp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="4sp"
                            android:layout_marginBottom="5dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="4sp"
                                android:text="✻  शोकाकुल  ✻"
                                android:textColor="@color/black"
                                android:textSize="17dp"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:id="@+id/form3Gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_78sdp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/death_card_rip_post_hindi3" />

                                <LinearLayout
                                    android:id="@+id/detail_form3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="2sp"
                                    android:layout_marginLeft="2sp"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginRight="2sp"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/setname1"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3sp"
                                            android:layout_weight="1"
                                            android:backgroundTint="#31ffffff"
                                            android:text=" भगवानभाई भोलाभाई गढिया "
                                            android:textColor="@color/hinttextcolor" />

                                        <TextView
                                            android:id="@+id/setnumber1"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLength="10"
                                            android:text=" ७८८९८९८९९८"
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/setname2"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3sp"
                                            android:layout_weight="1"
                                            android:text=" रणछोड़भाई भोलाभाई गढिया  "
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />

                                        <TextView
                                            android:id="@+id/setnumber2"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLength="10"
                                            android:text=" ७८८९८९८९९८"
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/setname3"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3sp"
                                            android:layout_weight="1"
                                            android:text=" गोविंदभाई भोलाभाई गढिया  "
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />

                                        <TextView
                                            android:id="@+id/setnumber3"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLength="10"
                                            android:text=" ७८८९८९८९९८"
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/setname4"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3sp"
                                            android:layout_weight="1"
                                            android:text=" लालूभाई रामभाई गढिया  "
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />

                                        <TextView
                                            android:id="@+id/setnumber4"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLength="10"
                                            android:text=" ७८८९८९८९९८"
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/setname5"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3sp"
                                            android:layout_weight="1"
                                            android:text=" कानाभाई रामभाई गढिया  "
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />

                                        <TextView
                                            android:id="@+id/setnumber5"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLength="10"
                                            android:text=" ७८८९८९८९९८"
                                            android:textColor="@color/hinttextcolor"
                                            android:textSize="14dp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/fsf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@color/light"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:weightSum="6">

                    <LinearLayout
                        android:id="@+id/form1"
                        android:layout_width="70dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="1"
