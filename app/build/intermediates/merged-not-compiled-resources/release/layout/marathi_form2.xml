<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/bgapp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="1.6">

        <ImageView
            android:id="@+id/close"
            android:layout_width="2dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:layout_weight="0.3"
            android:src="@drawable/death_card_rip_post_baseline_keyboard_arrow_left_24" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="शोकसभेची माहिती: "
            android:textColor="@color/button_textcolor"
            android:textSize="20dp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top">

        <TextView
            android:id="@+id/texts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="15dp"
            android:text="फॉर्म २"
            android:textColor="@color/bgapp"
            android:textSize="19dp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/rl_saveImagesss"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/texts"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="28dp"
                android:background="@drawable/death_card_rip_post_border_cir"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="2">

                <TextView
                    android:id="@+id/tele"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/death_card_rip_post_fill_cir"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="टेलीफोन"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nivas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="स्थानिक"
                    android:textColor="@color/dull"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/title"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginRight="10dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/b11"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="दिनांक"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="16dp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:id="@+id/open_date_picker"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_margin="2dp"
                                        android:background="@drawable/death_card_rip_post_ra_shpe"
                                        android:orientation="horizontal">

                                        <br.com.sapereaude.maskedEditText.MaskedEditText
                                            android:id="@+id/set_date"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:layout_weight="1.3"
                                            android:background="@null"
                                            android:gravity="start|center_vertical"
                                            android:inputType="number"
                                            android:padding="10dp"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/dull"
                                            android:textSize="16dp"
                                            app:mask="##/##/####" />

                                        <ImageView
                                            android:layout_width="0dp"
                                            android:layout_height="25dp"
                                            android:layout_gravity="center"
                                            android:layout_weight="0.2"
                                            android:gravity="center"
                                            android:src="@drawable/death_card_rip_post_ic_calendar" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/b21"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="@string/ne"
                                        android:textColor="@color/white"
                                        android:textSize="16dp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="वार"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="16dp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/var_select"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="4dp"
                                        android:background="@drawable/death_card_rip_post_ra_shpe"
                                        android:gravity="start|center_vertical"
                                        android:hint="रविवार"
                                        android:padding="10dp"
                                        android:textColor="@color/black"
                                        android:textColorHint="@color/dull"
                                        android:textSize="16dp" />

                                    <TextView
                                        android:id="@+id/b31"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_weight="1"
                                        android:text="@string/na"
                                        android:textColor="@color/white"
                                        android:textSize="16dp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:weightSum="2">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text=" दिवसाचा भाग"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="16dp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/time_select"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="4dp"
                                        android:background="@drawable/death_card_rip_post_ra_shpe"
                                        android:gravity="start|center_vertical"
                                        android:hint="सकाळ / दुपार / संध्याकाळ "
                                        android:padding="10dp"
                                        android:textColor="@color/black"
                                        android:textColorHint="@color/dull"
                                        android:textSize="16dp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="वेळ"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="16dp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_weight="1.5"
                                        android:gravity="center">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:weightSum="2.5">

                                            <EditText
                                                android:id="@+id/time2"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:layout_margin="2dp"
                                                android:layout_weight="1"
                                                android:background="@drawable/death_card_rip_post_ra_shpe"
                                                android:gravity="start|center_vertical"
                                                android:hint="०९:००"
                                                android:maxLength="5"
                                                android:padding="10dp"
                                                android:textColor="@color/black"
                                                android:textColorHint="@color/dull"
                                                android:textSize="16dp" />
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/lladdress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="पत्ता"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="16dp"
                                        android:textStyle="bold" />

                                    <EditText
                                        android:id="@+id/place_addrese"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_margin="4dp"
                                        android:background="@drawable/death_card_rip_post_ra_shpe"
                                        android:gravity="start|center_vertical"
                                        android:hint="पत्ता प्रविष्ट करा"
                                        android:isScrollContainer="false"
                                        android:maxLength="240"
                                        android:padding="10dp"
                                        android:textColor="@color/black"
                                        android:textColorHint="@color/dull"
                                        android:textSize="16dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/set_btn"
                                android:layout_width="120dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:layout_margin="6dp"
                                android:background="@drawable/ok_bg"
                                android:gravity="center"
                                android:text="ओके"
                                android:textColor="@color/white"
                                android:textSize="18dp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
